<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or subtitle or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or subtitle or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if medium_url %}article{% else %}website{% endif %}">
  {#- The picture shown when a page is shared: the page's ogImage, otherwise the 1200x630 site card
      (assets/share-jdcarlston.jpg: headline, portrait, address). #}
  {%- set shareImage = ogImage or (site.media.base + "/assets/share-jdcarlston.jpg") %}
  <meta property="og:image" content="{{ shareImage }}">
  <meta name="twitter:card" content="summary_large_image">
  {% structuredData shareImage %}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {% if not heroHeader %}
  <header class="bar">
    <div class="wrap bar__inner">
      <a class="brand" href="/">JD Carlston</a>
      {% include "nav.njk" %}
    </div>
  </header>
  {% endif %}

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer" id="contact">
    <div class="wrap footer__inner">
      <div class="footer__lead">
        <h2 class="footer__title">Let's talk.</h2>
        <p class="mono teal">Need is the flipside of the Value coin.</p>
      </div>
      <ul class="footer__links mono">
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><a href="https://www.linkedin.com/in/jdcarlston">linkedin.com/in/jdcarlston</a></li>
        <li><a href="https://github.com/jdcarlston">github.com/jdcarlston</a></li>
      </ul>
    </div>
    <p class="wrap footer__fine mono">© {{ site.year }} JD Carlston · Draper, Utah · <a href="https://github.com/jdcarlston/jdcarlston.com">source on GitHub</a></p>
  </footer>
</body>
</html>
