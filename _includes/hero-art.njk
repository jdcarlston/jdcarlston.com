<svg class="hero__art{{ ' hero__art--faint' if faint }}" viewBox="0 0 1440 760" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
  <path d="{{ hero.weaveV }}" fill="none" stroke="#2A2724" stroke-width="3"></path>
  <path d="{{ hero.weaveH }}" fill="none" stroke="#173536" stroke-width="3"></path>
  <path d="{{ hero.fibersDim }}" fill="none" stroke="#24403F" stroke-width="1.5" stroke-linecap="round"></path>
  <path d="{{ hero.fibersWarm }}" fill="none" stroke="#3A2F2A" stroke-width="1.5" stroke-linecap="round"></path>
  <path d="{{ hero.curveA }}" fill="none" stroke="#2E6B6E" stroke-width="1.5"></path>
  <path d="{{ hero.curveB }}" fill="none" stroke="#FF5757" stroke-width="2.5"></path>
  <circle cx="{{ hero.node.x }}" cy="{{ hero.node.y }}" r="7" fill="#0B0B0C" stroke="#4FA8AC" stroke-width="2"></circle>
</svg>
