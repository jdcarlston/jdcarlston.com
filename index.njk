<section class="hero" id="top">
  {% set faint = false %}{% include "hero-art.njk" %}
  <div class="wrap hero__inner">
    <header class="bar__inner hero__bar">
      <a class="brand" href="/">JD Carlston</a>
      {% include "nav.njk" %}
    </header>
    <div class="hero__copy">
      <p class="mono teal hero__eq">Trust = Consistency / Time</p>
      <h1 class="hero__title">Where systems<br>meet people.</h1>
      <div class="hero__intro">
        {% if site.hasPortrait %}
        <img class="portrait" src="/assets/profile.jpg" alt="JD Carlston" width="112" height="112">
        {% endif %}
        <p class="lede">I'm JD Carlston, an engineering leader, facilitator<br> and coach in Salt Lake City, with more than twenty<br> years building software and the teams that own it.</p>
      </div>
      <p class="muted hero__looking">Most recently Director of Product Engineering at Stack Overflow. Looking for a Director or VP of Engineering, Principal Architect or Fractional CTO role, in Salt Lake or remote.</p>
